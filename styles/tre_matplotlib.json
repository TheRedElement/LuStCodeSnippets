{
    "comments": {
        "axes": {
            "schema": "follow the plotly schema (add additional entries if necessary)"
        },
        "colors": {
            "naming": "c_<class>_[parameter]",
            "notes": [
                "c_main = accent color",
                "c_bg = primary color",
                "c_body_text = secondary color"
            ]
        },
        "figure": {
            "schema": "follow the plotly schema (add additional entries if necessary)"
        },
        "fontsizes": {
            "naming": "fs_<class>_[parameter]",
            "notes": [
                "use rem for outer world (top-lever containers)",
                "use em for inner world (any children i.e., lists, headers, ...)"
            ]
        },
        "line": {
            "schema": "follow the plotly schema (add additional entries if necessary)"
        },
        "marker": {
            "schema": "follow the plotly schema (add additional entries if necessary)"
        }
    },
    "axes": {
        "coloraxis": {
            "colorbar": {
                "outlinewidth": 5
            }
        },
        "xaxis": {
            "automargin": true,
            "minor": {
                "ticks": "inside"
            },
            "showgrid": true,
            "showline": true,
            "spines": [
                "bottom"
            ],
            "ticks": "inside",
            "visible": true,
            "zeroline": false
        },
        "yaxis": {
            "automargin": true,
            "minor": {
                "ticks": "inside"
            },
            "showgrid": true,
            "showline": true,
            "spines": [
                "left"
            ],
            "ticks": "inside",
            "visible": true,
            "zeroline": false
        },
        "zaxis": {
            "automargin": true,
            "minor": {
                "ticks": "inside"
            },
            "showgrid": true,
            "showline": true,
            "spines": [
                "left"
            ],
            "ticks": "inside",
            "visible": true,
            "zeroline": false
        }
    },
